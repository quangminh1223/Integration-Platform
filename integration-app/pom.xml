<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>msb.com.vn</groupId>
        <artifactId>integration-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>integration-app</artifactId>
    <name>Integration Platform - Application</name>
    <description>Spring Boot application assembling all modules</description>

    <dependencies>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-core</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-transformer</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-router</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-security</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-config</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>msb.com.vn</groupId>
            <artifactId>integration-monitoring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
